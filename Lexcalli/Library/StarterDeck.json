    },
    {
      "id": "0B1E5A2C-7F3D-4C61-9A8E-2D0000000006",
      "term": "Τα λέμε!",
      "meaning": "Увидимся"
    },
    {
      "id": "0B1E5A2C-7F3D-4C61-9A8E-2D0000000007",
      "term": "Πώς τον/την λένε;",
