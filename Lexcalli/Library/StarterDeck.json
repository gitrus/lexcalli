      "term": "γεια σας",
      "meaning": "Здравствуйте"
    },
    {
      "id": "0B1E5A2C-7F3D-4C61-9A8E-2D0000000003",
      "term": "πώς σε λένε;",
      "meaning": "Как тебя зовут?"
    },
    {
      "id": "0B1E5A2C-7F3D-4C61-9A8E-2D0000000004",
      "term": "χαίρω πολύ",
      "meaning": "очень приятно"
    },
    {
      "id": "0B1E5A2C-7F3D-4C61-9A8E-2D0000000005",
      "term": "Από πού είσαι/είστε;",
